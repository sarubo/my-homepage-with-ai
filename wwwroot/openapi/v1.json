{
  "openapi": "3.0.3",
  "info": {
    "title": "FileShare Server API",
    "version": "1.0.0",
    "description": "RAM 上のファイルを一覧・アップロード・ダウンロード・削除する API。"
  },
  "paths": {
    "/api/files": {
      "get": { "summary": "ファイル一覧を取得", "responses": { "200": { "description": "一覧" } } },
      "post": {
        "summary": "複数ファイルをアップロード",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "files": { "type": "array", "items": { "type": "string", "format": "binary" } } } } } } },
        "responses": { "200": { "description": "保存したファイル" }, "400": { "description": "不正なリクエスト" } }
      },
      "delete": {
        "summary": "選択したファイルを削除",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["ids"], "properties": { "ids": { "type": "array", "items": { "type": "string", "format": "uuid" } } } } } } },
        "responses": { "200": { "description": "削除件数" } }
      }
    },
    "/api/files/{id}/download": {
      "get": {
        "summary": "ファイルを個別にダウンロード",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "ファイル本体", "content": { "application/octet-stream": {} } }, "404": { "description": "見つからない" } }
      }
    }
  }
}
